{
  "manifest_version": 3,
  "name": "Kalvidres Downloader",
  "version": "1.0.1",
  "description": "Aggiunge un pulsante per scaricare le lezioni video Kaltura di Moodle UniPD.",
  "browser_specific_settings": {
    "gecko": {
      "id": "kalvidres-downloader@zac06.github.io",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "permissions": [
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.unipd.it/*",
    "https://*.kaltura.com/*"
  ],
  "background": {
    "scripts": [
      "lib.js",
      "background.js"
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.unipd.it/mod/kalvidres/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  }
}
