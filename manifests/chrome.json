{
  "manifest_version": 3,
  "name": "Kalvidres Downloader",
  "version": "1.0.1",
  "description": "Aggiunge un pulsante per scaricare le lezioni video Kaltura di Moodle UniPD.",
  "minimum_chrome_version": "102",
  "permissions": [
    "downloads",
    "storage",
    "webRequest"
  ],
  "host_permissions": [
    "https://*.unipd.it/*",
    "https://*.kaltura.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.unipd.it/mod/kalvidres/*"
      ],
      "js": [
        "lib.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
